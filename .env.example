# Copy this file to .env.local and fill in your values.
# Leave Supabase values empty to use the demo enquiry form (no data is saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# International format, digits only; example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=917989581582
NEXT_PUBLIC_BUSINESS_NAME=Kerala car rentals, vacation and holidays


# Server-only WhatsApp Cloud API credentials. Never prefix with NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ITINERARY_TEMPLATE=kerala_trip_itinerary
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0
